# Development; uvicorn does not automatically read this file.
# Export these variables in your shell or container configuration.
PANTRY_ENV=development
PANTRY_DATABASE=data/pantry-relay.sqlite3
PANTRY_DEMO_ENABLED=true
PANTRY_COOKIE_SECURE=false
# Production requires explicit PANTRY_ALLOWED_HOSTS, secure cookies, demo disabled,
# HTTPS at the reverse proxy, one app instance, and persistent disk.
# PANTRY_ALLOWED_HOSTS=relay.example.org
